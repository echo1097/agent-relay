[Unit]
Description=Agent Relay background daemon
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart={{.Binary}} daemon --home {{.Home}}
WorkingDirectory=/
Environment={{.SearchPath}}
Restart=always
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
